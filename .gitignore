broadcast/

# one-off deploy scratch: raw initcode for the live deployment
.deploy_data.txt
deploy-now.mjs
deploy-fork.mjs
.commitmsg.txt

# One-off operator scripts. Each reads a private key from a fixed absolute path
# on the author's machine, so a reviewer can neither run them nor should be
# handed them. They verify real mainnet activity and remain available locally.
deploy-check.mjs
mainnet-proof.mjs
request-flow.mjs

# Deployment helpers. Useful, but not part of the app and not needed to build
# it, so they stay out of the tree to keep the repo to the product itself.
deploy-fixed.sh
preflight.sh
deploy-request.sh
estimate.sh
verify-mainnet.sh
verify-fix2-mainnet.sh
trace-usdc.py
trace-tx.py
probe-logs.py
prove-transfers.py
# UI verification. Four of these run against files that ship, so a reviewer can
# reproduce the README's numbers rather than take them on trust:
#   check-landing  7/7 viewport sizes and contrast, on landing.html
#   check-fixes    regression guard for the React className bug
#   check-motion   the landing video keeps playing unattended
#   check-popup    6/6 settled-request popup sizes
#
# check-pixels and check-rhyme stay out because they target
# landing.linear.html, which is not in the tree - shipping them would hand a
# reviewer a guaranteed ERR_CONNECTION_REFUSED.
check-pixels.cjs
check-rhyme.cjs
